generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- MARKET DATA ---

model Tick {
  id        String   @id @default(cuid())
  symbol    String
  bid       Decimal
  ask       Decimal
  spread    Decimal
  volume    Decimal
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([symbol, timestamp])
}

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String // 1m, 5m, 15m, 30m, 1h, 4h, 1d
  open      Decimal
  high      Decimal
  low       Decimal
  close     Decimal
  volume    Decimal
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  // Relations
  indicators CandleIndicator?

  @@index([symbol, timeframe, timestamp])
  @@unique([symbol, timeframe, timestamp])
}

model CandleIndicator {
  id             String  @id @default(cuid())
  candleId       String  @unique
  atr            Decimal
  rsi            Decimal
  macd           Decimal?
  macdSignal     Decimal?
  macdHistogram  Decimal?
  ema20          Decimal
  ema50          Decimal
  ema100         Decimal?
  vwap           Decimal
  adx            Decimal
  bbUpper        Decimal
  bbMiddle       Decimal
  bbLower        Decimal
  createdAt      DateTime @default(now())

  candle Candle @relation(fields: [candleId], references: [id], onDelete: Cascade)
}

// --- TRADING ACCOUNT ---

model AccountSnapshot {
  id              String   @id @default(cuid())
  balance         Decimal
  equity          Decimal
  margin          Decimal
  marginLevel     Decimal?
  floatingPL      Decimal
  openPositions   Int
  currency        String
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([timestamp])
}

model Position {
  id            String   @id @default(cuid())
  ticket        String
  symbol        String
  direction     String   // "BUY" | "SELL"
  openPrice     Decimal
  currentPrice  Decimal
  sl            Decimal?
  tp            Decimal?
  lotSize       Decimal
  profit        Decimal
  openTimestamp DateTime
  closeTimestamp DateTime?
  isOpen        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // DNA Relation
  tradeDnaId String?
  tradeDna   TradeDNA? @relation(fields: [tradeDnaId], references: [id], onDelete: SetNull)

  @@index([ticket])
  @@index([isOpen])
  @@index([createdAt])
}

// --- TRADING ---

model TradeDNA {
  id                String   @id @default(cuid())
  ticket            String
  symbol            String
  direction         String
  entryPrice        Decimal
  stopLoss          Decimal
  takeProfit        Decimal
  lotSize           Decimal
  riskPercent       Decimal
  outcome           String   // "WIN" | "LOSS" | "BREAKEVEN" | "OPEN"
  profitPips        Decimal
  profitPercent     Decimal
  profitDollars     Decimal
  aiConfidence      Decimal
  modelVersion      String
  mistakes          String[]
  lessons           String[]
  notes             String?
  entryFeatures     Json
  closeFeatures     Json?
  screenshots       Json?
  entryTimestamp    DateTime
  closeTimestamp    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  positions Position[]

  @@index([ticket])
  @@index([outcome])
  @@index([entryTimestamp])
}

// --- MARKET CONTEXT ---

model EconomicEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  currency    String
  impact      String   // "LOW" | "MEDIUM" | "HIGH" | "EXTREME"
  actual      String?
  forecast    String?
  previous    String?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@index([timestamp])
  @@index([impact])
}

model MarketSession {
  id        String   @id @default(cuid())
  session   String   // "ASIA" | "LONDON" | "NEWYORK" | "OVERLAP"
  startUTC  String
  endUTC    String
  createdAt DateTime @default(now())
}

// --- LEARNING & AI ---

model Lesson {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String
  impact      String   // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  dnaIds      String[]
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ModelCandidate {
  id                   String   @id @default(cuid())
  version              String
  trainingDate         DateTime
  winRate              Decimal
  profitFactor         Decimal
  avgProfit            Decimal
  sharpeRatio          Decimal
  status               String
  deploymentRec        String
  recReason            String
  createdAt            DateTime @default(now())
}
