# =====================================================================
# LiquiBot — .env REFERENCE TEMPLATE
#
# TWO COPIES OF THIS EXIST:
#   A) backend/.env            → Local development (your laptop)
#   B) Render Dashboard Env    → Cloud production (DO NOT commit secrets)
#
# Each copy has DIFFERENT values for the keys below prefixed with
# "[LOCAL]" vs "[CLOUD]". Swap accordingly. Do NOT hardcode a single
# localhost-only .env for production — the AI will train and run but
# the EA will never reach your server, and the EA will never reach
# your production Postgres from a local DATABASE_URL.
# =====================================================================

# ============================================================
# 1. SERVER
# ============================================================
# [LOCAL]  development | [CLOUD] production
NODE_ENV=development
# [LOCAL] 5000         | [CLOUD] 8080 (Render / Docker internal port)
PORT=5000

# ============================================================
# 2. AUTH & SECRETS (REQUIRED IN PRODUCTION — server refuses to start if missing)
# ============================================================
# Generate both with: openssl rand -hex 32
JWT_SECRET=replace-with-long-random-hex-64chars
ADMIN_PASSWORD=replace-with-admin-ui-password

# Static "bearer token" the MT5 EA uses to talk to this server.
# MUST EQUAL the exact string you paste into the EA's "ApiKey" input in MT5.
# [LOCAL]  dev_local_ea_key_change_me (matches ScalpKing_EA defaults for quick tests)
# [CLOUD] a 32+ char random string — then copy into MT5 EA's ApiKey input
EA_API_KEY=replace-with-ea-api-key
MT5_BRIDGE_API_KEY=replace-with-ea-api-key
API_KEY_SECRET=replace-with-second-long-secret

# ============================================================
# 3. DATABASE
# ============================================================
# [LOCAL]  postgres://postgres:postgres@localhost:5432/liquibot?schema=public
# [CLOUD]  Render PostgreSQL "Connection String" (internal) — looks like:
#          postgres://liquibot:<pass>@dpg-xxxx.db.render.com:5432/liquibot
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liquibot?schema=public"

# ============================================================
# 4. PYTHON / AI BRIDGE
# ============================================================
# Path the Node.js child_process wrapper spawns for train.py/inference.py.
# [LOCAL]  Windows: C:\Users\You\...\.venv\Scripts\python.exe
#          macOS/Linux: /usr/bin/python3 or path/to/venv/bin/python
# [CLOUD]  /usr/bin/python (set by Dockerfile — do NOT change in Render)
PYTHON_PATH=C:\absolute\path\to\LiquiBot\.venv\Scripts\python.exe

# AI gating defaults — can be tweaked via runtime API on both local/cloud.
# aiTradingEnabled=false means AI SHADOW MODE: logs all predictions,
# never blocks a rule-engine trade. Flip to true after +50 shadow wins.
AI_TRADING_ENABLED=false
AI_MIN_CONFIDENCE=0.6
AI_CONTRADICTION_VETO_THRESHOLD=0.55

# Continuous learning triggers
CL_MIN_SAMPLES=20           # min labeled trades before first auto-train
CL_TRAIN_EVERY_N=15         # fire background train every N closed trades
CL_TRAIN_INTERVAL_MS=21600000  # also fire train every 6h (21600000ms)
CL_TRAIN_EPOCHS=60

# ============================================================
# 5. CORS (EA never uses CORS, it's server-to-server — this
#    protects browser / mobile app origins only)
# ============================================================
# [LOCAL] Comma-separated dev UIs:
#         http://localhost:19006,http://localhost:8081,http://localhost:5000
# [CLOUD] Your hosted Expo / web domain + Render wildcard:
#         https://*.expo.dev,https://your-frontend.vercel.app,https://*.onrender.com
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:5000

# ============================================================
# 6. TRADING DEFAULTS (override per EA input at runtime if desired)
# ============================================================
SIGNAL_SCAN_INTERVAL_MS=30000
SIGNAL_CACHE_TTL_SECONDS=60
CONFLUENCE_THRESHOLD=75
BACKEND_BRAIN_DEFAULT_MODE=app

# ============================================================
# 7. MARKET DATA PROVIDER (Optional — ONLY if you pull candles from a
#    3rd-party API instead of the EA's own candle snapshots. The EA
#    sends all candles today, so leave these blank until you need it.)
# ============================================================
MARKET_DATA_PROVIDER=
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=

# ============================================================
# 8. CACHE / QUEUE (Optional for future scale-out)
# ============================================================
# [LOCAL]  redis://127.0.0.1:6379
# [CLOUD]  Render Redis / Upstash connection string
REDIS_URL=
